---
import { photos, type PhotoKey } from "../data/site";
interface Props {
  photo: PhotoKey;
  class?: string;
  eager?: boolean;
  sizes?: string;
}
const {
  photo,
  class: cls,
  eager = false,
  sizes = "(max-width: 760px) 100vw, 50vw",
} = Astro.props;
const p = photos[photo];
const widths = [
  ...new Set([480, 900, Math.min(1600, p.width)].filter((w) => w <= p.width)),
].sort((a, b) => a - b);
---

<picture class="photo">
  <source
    type="image/avif"
    srcset={widths.map((w) => `/images/${p.name}-${w}.avif ${w}w`).join(", ")}
    sizes={sizes}
  />
  <img
    src={`/images/${p.name}-${widths[widths.length - 1]}.webp`}
    srcset={widths.map((w) => `/images/${p.name}-${w}.webp ${w}w`).join(", ")}
    sizes={sizes}
    width={p.width}
    height={p.height}
    alt={p.alt}
    class={cls}
    loading={eager ? "eager" : "lazy"}
    fetchpriority={eager ? "high" : "auto"}
    decoding="async"
  />
</picture>
