# Canonical production origin supplied for this audit.
PUBLIC_SITE_URL=https://singhhomestay.in
# Leave blank: VERCEL_ENV=production enables indexing; previews/local stay noindex.
# For a local public-build audit only, set true. Explicit false disables indexing.
PUBLIC_INDEXABLE=
# Server-side only: used by npm run images:generate. Never commit a real key.
OPENAI_API_KEY=
